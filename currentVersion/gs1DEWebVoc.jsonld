        {
            "@id": "gs1de:importClassificationTypeCode",
            "@type": [
                "owl:ObjectProperty",
                "rdf:Property"
            ],
            "rdfs:comment": {
                "@language": "en",
                "@value": "Imports and exports of trade items typically require classification codes to determine appropriate duties and tariffs. Values include Netherlands Import Code, Harmonized Commodity Description and Coding System, Custom Tariff and INTRASTRAT Code, Harmonized Tariff Schedule of the United States, INTRASTRAT Combined Nomenclature, Tarif Intégré de la Communauté. "
            },
            "rdfs:domain": {
