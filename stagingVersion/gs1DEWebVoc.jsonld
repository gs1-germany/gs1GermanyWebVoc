                "@language": "en",
                "@value": "ReCiPe"
            },
            "skos:prefLabel": "RECIPE",
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:CfpMethodologyCode-PEF",
            "@type": "gs1de:CfpMethodologyCode",
            "rdfs:comment": {
                "@language": "en",
                "@value": "The Product Environmental Footprint (PEF) methodology is performed following the PEF guidelines published by the European Commission and, if available, specific category rules (PEFCRs)."
            },
            "rdfs:label": {
                "@language": "en",
                "@value": "PEF"
            },
            "skos:prefLabel": "PEF",
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:CfpMethodologyCode-OTHER",
            "@type": "gs1de:CfpMethodologyCode",
            "rdfs:comment": {
                "@language": "en",
                "@value": "A standard calculation method, not classified in the codelist."
            },
            "rdfs:label": {
                "@language": "en",
