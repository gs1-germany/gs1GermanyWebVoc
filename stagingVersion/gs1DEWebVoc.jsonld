            "@id": "gs1de:CfpMethodologyCode-RECIPE",
            "@type": "gs1de:CfpMethodologyCode",
            "rdfs:comment": {
                "@language": "en",
                "@value": "Based on National Institute for Public Health and the Environment (RIVM), Institute of Environmental Sciences (CML), Product Category Rule (PCR)."
            },
