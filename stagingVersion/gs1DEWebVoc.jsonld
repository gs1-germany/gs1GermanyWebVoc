        {
            "@id": "gs1de:TradeItemUnitDescriptorCode",
            "@type": "owl:Class",
            "rdfs:label": [
                {
                    "@value": "Trade Item Unit Descriptor Code",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "The condition of the product sold to the end consumer for example thawed or frozen.",
                "@language": "en"
            },
            "rdfs:subClassOf": {
                "@id": "gs1:TypeCode"
            },
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-BASE_UNIT_OR_EACH",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Base Unit or Each",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "The lowest level of the item hierarchy intended or labeled for individual resale.",
                "@language": "en"
            },
            "skos:prefLabel": "BASE_UNIT_OR_EACH",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-CASE",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Case",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "A standard trade item shipping unit that contains a single or multiple GTINs. Includes an ½ or ¼ pallet and an ½ or ¼ box pallet.",
                "@language": "en"
            },
            "skos:prefLabel": "CASE",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-DISPLAY_SHIPPER",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Display Shipper",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "A display or shipper is a special case item that includes both consumer units and packaging materials to be assembled and used to display the product for sale. May contain cases or consumer units. It may be the orderable or dispatchable unit and may be shipped on a pallet.",
                "@language": "en"
            },
            "skos:prefLabel": "DISPLAY_SHIPPER",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-MIXED_MODULE",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Display Ready Pallet",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Special pallet item sold as a single unit that is not intended to be broken down to sell the cases individually. It is intended to be displayed directly on the selling floor and shoppable for the consumer and may contain additional packaging materials used to further display the product. It may contain single or multiple GTINs and may be the orderable unit.",
                "@language": "en"
            },
            "skos:prefLabel": "MIXED_MODULE",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-PACK_OR_INNER_PACK",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Pack or Inner Pack",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "A logistical unit between case and each. This may be a consumable innerpack (i.e. Carton of Cigarettes) or it may be simply a logistical pack (i.e. Dozes of toothbrushes).",
                "@language": "en"
            },
            "skos:prefLabel": "PACK_OR_INNER_PACK",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-PALLET",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Pallet",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "A unit load that contains a single or multiple GTINs Includes box pallet",
                "@language": "en"
            },
            "skos:prefLabel": "PALLET",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TradeItemUnitDescriptorCode-TRANSPORT_LOAD",
            "@type": "gs1de:TradeItemUnitDescriptorCode",
            "rdfs:label": [
                {
                    "@value": "Transport Load",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Trade item above the pallet level used for transporting trade items. For example truck load, container, rail car, ship, etc.",
                "@language": "en"
            },
            "skos:prefLabel": "TRANSPORT_LOAD",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode",
            "@type": "owl:Class",
            "rdfs:label": [
                {
                    "@value": "Temperature Qualifier Code",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Code qualifying the type of a temperature requirement for example Storage.",
                "@language": "en"
            },
            "rdfs:subClassOf": {
                "@id": "gs1:TypeCode"
            },
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-DELIVERY_TO_DISTRIBUTION_CENTRE",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Delivery To Distribution Centre",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Trade Item is in transport to the distribution center.",
                "@language": "en"
            },
            "skos:prefLabel": "DELIVERY_TO_DISTRIBUTION_CENTRE",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-DELIVERY_TO_MARKET",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Delivery To Market",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Trade Item is in transport to market.",
                "@language": "en"
            },
            "skos:prefLabel": "DELIVERY_TO_MARKET",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-DISINFECTION",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Disinfection",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Specifies the temperature the product is to be maintained at for the process that eliminates many or all pathogenic microorganisms, except bacterial spores, on inanimate objects. In health-care settings, objects can be disinfected by liquid chemicals or wet pasteurisation.",
                "@language": "en"
            },
            "skos:prefLabel": "DISINFECTION",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-INLET_TEMPERATURE",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Inlet Temperature",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Specifies the temperature at which a gas or fluid is expected to be when entering a device, e.g., an electric pressure washer. The device may be damaged when the inlet temperature is outside the range of temperatures.",
                "@language": "en"
            },
            "skos:prefLabel": "INLET_TEMPERATURE",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-OPERATING_TEMPERATURE",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Operating Temperature",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Specifies the temperature at which the product operates effectively. The product will operate effectively within a specified temperature range which varies based on the function and application context, and ranges from the minimum operating temperature to the maximum operating temperature (or peak operating temperature). Outside this range of safe operating temperatures the product may fail or the protective properties are no longer guaranteed.",
                "@language": "en"
            },
            "skos:prefLabel": "OPERATING_TEMPERATURE",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-STERILISATION",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Sterilisation",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Specifies the temperature the product should be sterilised at in accordance to supplier or local market regulations.",
                "@language": "en"
            },
            "skos:prefLabel": "STERILISATION",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-STORAGE_AFTER_OPENING",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Storage After Opening",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Specifies the temperature the product is to be maintained at after its seal has been broken and the product has been exposed to the elements.",
                "@language": "en"
            },
            "skos:prefLabel": "STORAGE_AFTER_OPENING",
            "rdfs:isDefinedBy": {
                "@id": "gs1de:"
            },
            "sw:term_status": "testing"
        },
        {
            "@id": "gs1de:TemperatureQualifierCode-STORAGE_AFTER_OVERWRAP",
            "@type": "gs1de:TemperatureQualifierCode",
            "rdfs:label": [
                {
                    "@value": "Storage After Removing Overwrap",
                    "@language": "en"
                }
            ],
            "rdfs:comment": {
                "@value": "Specifies the temperature the product is to be maintained at after removing a product’s protective overwrap or moisture barrier.",
                "@language": "en"
